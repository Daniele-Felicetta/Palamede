{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["svelte", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"],
  // src/ui = kit sperimentale stile SvelteKit (alias $lib, assets e micromark
  // assenti su Vite): resta nel repo ma fuori dalla build finché non verrà
  // migrato. Il canonico è src/components/ui/.
  "exclude": ["node_modules", "dist", "src/ui/**/*"]
}