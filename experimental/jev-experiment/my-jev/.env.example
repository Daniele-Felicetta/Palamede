OPENROUTER_API_KEY=

# Local models, started automatically by "pnpm dev":
#   proposer (question structure) -> K2-Horizon on :8081
#   chat (free chat)              -> MiniCPM    on :8080
# Override the endpoints if you run your own OpenAI-compatible servers.
LOCAL_LLM_URL=http://127.0.0.1:8081/v1/chat/completions
LOCAL_CHAT_URL=http://127.0.0.1:8080/v1/chat/completions
LOCAL_LLM_MODEL=

# Set LOCAL_MODEL=0 to stop "pnpm dev" from launching the local model servers.
LOCAL_MODEL=

# Set LOCAL_LLM_THINK=0 for a non-reasoning proposer (no chain-of-thought + JSON grammar).
LOCAL_LLM_THINK=
