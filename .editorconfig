root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# TypeScript / frontend (Vite: 2 spazi)
[*.{ts,tsx,js,mjs,jsx,css,html,json}]
indent_style = space
indent_size = 2

# PowerShell
[*.ps1]
indent_style = space
indent_size = 4

# Python
[*.py]
indent_style = space
indent_size = 4

# C#
[*.cs]
indent_style = space
indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false
