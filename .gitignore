# ── Modelli locali ──────────────────────────────────────────────
# I modelli sono rigenerabili/ricopiabili da reference/ (scripts/copy-models.ps1)
models/

# ── Cartella di riferimento esterna ─────────────────────────────
# Non fa parte del progetto: repo e pesi sorgente, mai toccata in scrittura.
reference/

# ── Engine binari scaricati (stable-diffusion.cpp) ─────────────
tools/

# ── Launcher compilato (rigenerabile con scripts/build.ps1) ──
*.exe

# ── Build Tauri (app desktop nativa) ───────────────────────────
src-tauri/target/
src-tauri/gen/

# cache di rust-analyzer / build Rust generica
target/

# ── Flusso legacy .NET (archiviato in legacy/) ──────────────────
# Vecchio launcher WinForms + bundle incorporato. Sostituito da Tauri v2,
# mantenuto solo come riferimento storico.
legacy/palamede.bundle
legacy/runtime.stamp
# generato da legacy/scripts/build-launcher.ps1 dal PNG palamede_icon.png
palamede_icon.ico

# ── Dipendenze / build ──────────────────────────────────────────
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo

# ── Ambienti Python ─────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc

# ── Output di generazione (la UI salva qui) ─────────────────────
# NB: gli esempi della wiki vivono in frontend/public/examples e sono
# versionati: niente wildcard *.png globali.
outputs/
.serve-logs/

# ── Knowledge base dell'utente (RAG) ────────────────────────────
# Fonti raw + indice chunk/embedding: contenuto personale, non versionato.
knowledge/

# ── JEV Hub: log dei progetti sperimentali avviati ──────────────
experimental/jev-hub/logs/

# ── Varie ───────────────────────────────────────────────────────
*.log
.env
.env.*
# l'esempio è versionato: serve a sapere quali chiavi opzionali esistono
!.env.example